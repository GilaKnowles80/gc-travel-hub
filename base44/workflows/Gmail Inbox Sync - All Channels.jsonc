{
  "name": "Gmail Inbox Sync - All Channels",
  "description": "Syncs unread emails from info@, sales@, helpdesk@, support@, and bookings@gctravelandtours.com into the helpdesk every 5 minutes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-03-09T02:10:26.620000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gmail_inbox_sync_all_channels",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGmailToHelpdesk",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}