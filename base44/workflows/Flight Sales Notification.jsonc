{
  "name": "Flight Sales Notification",
  "description": "Notify admins when a flight booking is created",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "FlightBooking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "flight_sales_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySalesAdmin",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}