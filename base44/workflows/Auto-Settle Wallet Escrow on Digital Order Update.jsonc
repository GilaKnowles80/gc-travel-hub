{
  "name": "Auto-Settle Wallet Escrow on Digital Order Update",
  "description": "On DigitalOrder payment_status change to paid/failed/cancelled/refunded, settles the wallet escrow (100% GC commission on success, 100% release on failure)",
  "trigger": {
    "condition": "${ .trigger.data.payment_status != .trigger.old_data.payment_status and (.trigger.data.payment_status == \"paid\" or .trigger.data.payment_status == \"failed\" or .trigger.data.payment_status == \"cancelled\" or .trigger.data.payment_status == \"refunded\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DigitalOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_settle_wallet_escrow_digital",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processWalletEscrow",
            "args": {
              "action": "settle",
              "booking_id": "${ .trigger.entity_id }",
              "booking_type": "digital",
              "status": "${ .trigger.data.payment_status }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Settle digital order wallet escrow"
          }
        }
      }
    ]
  }
}