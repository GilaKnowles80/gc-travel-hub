{
  "name": "SettlementAccount",
  "type": "object",
  "properties": {
    "account_type": {
      "type": "string",
      "enum": [
        "supplier_settlement",
        "revenue_account",
        "liability_account"
      ],
      "description": "Type of settlement account"
    },
    "supplier_id": {
      "type": "string",
      "description": "Supplier ID (if applicable)"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name for reference"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current account balance"
    },
    "total_earned": {
      "type": "number",
      "default": 0,
      "description": "Total revenue earned"
    },
    "total_paid": {
      "type": "number",
      "default": 0,
      "description": "Total amount paid out"
    },
    "bank_account_number": {
      "type": "string",
      "description": "Bank account number (encrypted)"
    },
    "bank_name": {
      "type": "string",
      "description": "Bank institution name"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Account holder full name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_verification",
        "suspended",
        "closed"
      ],
      "default": "pending_verification",
      "description": "Account verification status"
    },
    "last_settlement_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last settlement payout date"
    },
    "next_settlement_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled settlement date"
    },
    "settlement_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "monthly",
      "description": "Settlement payout frequency"
    },
    "minimum_payout_threshold": {
      "type": "number",
      "default": 1000,
      "description": "Minimum balance to trigger payout"
    },
    "verification_notes": {
      "type": "string",
      "description": "Admin notes on verification"
    }
  },
  "required": [
    "account_type",
    "balance"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}