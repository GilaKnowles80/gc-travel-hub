{
  "name": "SupplierMessage",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "Target supplier (null for broadcast to all)"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "admin",
        "supplier",
        "system"
      ],
      "description": "Who sent the message"
    },
    "sender_email": {
      "type": "string",
      "description": "Sender email"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender name"
    },
    "subject": {
      "type": "string",
      "description": "Message subject"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "announcement",
        "support",
        "payment",
        "update",
        "alert"
      ],
      "description": "Type of message"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Message priority"
    },
    "parent_message_id": {
      "type": "string",
      "description": "Reply to message ID (for threads)"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    },
    "is_broadcast": {
      "type": "boolean",
      "default": false,
      "description": "Sent to all suppliers"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Attachment URLs"
    }
  },
  "required": [
    "sender_type",
    "subject",
    "message",
    "message_type"
  ]
}