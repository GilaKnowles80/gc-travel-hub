{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Recipient email"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "type": {
      "type": "string",
      "enum": [
        "booking_created",
        "booking_confirmed",
        "booking_completed",
        "booking_cancelled",
        "booking_updated",
        "payment_confirmed",
        "payment_failed",
        "refund_processed",
        "supplier_payment_done",
        "checkout_payment",
        "reservation_confirmed",
        "reservation_cancelled",
        "reservation_updated",
        "order_created",
        "order_completed",
        "order_shipped",
        "order_cancelled",
        "info"
      ],
      "description": "Notification type"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "flight",
        "hotel",
        "tour",
        "ferry",
        "bus",
        "car_rental",
        "visa",
        "cruise",
        "train",
        "package",
        "insurance",
        "digital",
        "reservation"
      ],
      "description": "Category of booking/order this notification relates to"
    },
    "booking_id": {
      "type": "string",
      "description": "Related booking ID if applicable"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "link": {
      "type": "string",
      "description": "Link to related page"
    }
  },
  "required": [
    "user_email",
    "title",
    "message",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}