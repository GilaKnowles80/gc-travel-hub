{
  "name": "Booking",
  "type": "object",
  "properties": {
    "booking_ref": {
      "type": "string",
      "description": "Human-readable booking reference (e.g. TRP0000001)"
    },
    "tour_id": {
      "type": "string",
      "description": "Reference to the tour"
    },
    "tour_title": {
      "type": "string",
      "description": "Tour title for quick reference"
    },
    "trip_type": {
      "type": "string",
      "enum": [
        "one_way",
        "roundtrip"
      ],
      "default": "roundtrip",
      "description": "Trip type"
    },
    "customer_name": {
      "type": "string",
      "description": "Full name of the customer"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "number_of_travelers": {
      "type": "number",
      "description": "Number of travelers"
    },
    "departure_date": {
      "type": "string",
      "format": "date",
      "description": "Selected departure date"
    },
    "total_price": {
      "type": "number",
      "description": "Total booking price"
    },
    "special_requests": {
      "type": "string",
      "description": "Any special requests"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid",
        "refunded"
      ],
      "default": "unpaid",
      "description": "Payment status"
    },
    "supplier": {
      "type": "string",
      "enum": [
        "biyaheko",
        "wanderlinx",
        "tripzynx",
        "direct"
      ],
      "description": "Supplier used for booking"
    },
    "supplier_reference": {
      "type": "string",
      "description": "Reference number from supplier"
    },
    "price_comparison_notes": {
      "type": "string",
      "description": "Notes on price comparison across suppliers"
    }
  },
  "required": [
    "tour_id",
    "customer_name",
    "customer_email",
    "number_of_travelers",
    "trip_type"
  ]
}