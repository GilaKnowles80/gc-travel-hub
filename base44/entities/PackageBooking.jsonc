{
  "name": "PackageBooking",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who created the package"
    },
    "package_name": {
      "type": "string",
      "description": "Custom package name"
    },
    "flights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flight_id": {
            "type": "string"
          },
          "cabin_class": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "passengers": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Selected flights"
    },
    "hotels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hotel_id": {
            "type": "string"
          },
          "nights": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "rooms": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Selected hotels"
    },
    "tours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tour_id": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "participants": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Selected tours"
    },
    "total_price": {
      "type": "number",
      "description": "Total package price"
    },
    "discount_percentage": {
      "type": "number",
      "default": 0,
      "description": "Package discount percentage"
    },
    "final_price": {
      "type": "number",
      "description": "Final price after discount"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "paid",
        "cancelled"
      ],
      "default": "draft",
      "description": "Package status"
    },
    "payment_id": {
      "type": "string",
      "description": "Associated payment"
    },
    "user_country": {
      "type": "string",
      "description": "User's country for analytics"
    },
    "user_ip": {
      "type": "string",
      "description": "User's IP address for location tracking"
    }
  },
  "required": [
    "user_email",
    "package_name"
  ]
}