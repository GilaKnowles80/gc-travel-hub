{
  "name": "FerryBooking",
  "type": "object",
  "properties": {
    "booking_ref": {
      "type": "string",
      "description": "Human-readable booking reference (e.g. FRY0000001)"
    },
    "route": {
      "type": "string",
      "description": "Ferry route (e.g., Manila - Cebu)"
    },
    "ferry_company": {
      "type": "string",
      "description": "Ferry company name"
    },
    "departure_date": {
      "type": "string",
      "format": "date",
      "description": "Departure date"
    },
    "departure_time": {
      "type": "string",
      "description": "Departure time"
    },
    "passenger_name": {
      "type": "string",
      "description": "Passenger name"
    },
    "passenger_email": {
      "type": "string",
      "description": "Passenger email"
    },
    "passenger_phone": {
      "type": "string",
      "description": "Passenger phone"
    },
    "number_of_passengers": {
      "type": "number",
      "default": 1,
      "description": "Number of passengers"
    },
    "accommodation_type": {
      "type": "string",
      "enum": [
        "economy",
        "tourist_class",
        "cabin",
        "suite"
      ],
      "description": "Accommodation type"
    },
    "total_price": {
      "type": "number",
      "description": "Total booking price"
    },
    "special_requests": {
      "type": "string",
      "description": "Special requests"
    },
    "supplier": {
      "type": "string",
      "enum": [
        "biyaheko",
        "wanderlinx",
        "tripzynx",
        "12go",
        "direct"
      ],
      "description": "Supplier used for booking"
    },
    "supplier_reference": {
      "type": "string",
      "description": "Reference number from supplier"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    }
  },
  "required": [
    "route",
    "passenger_name",
    "passenger_email",
    "departure_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.passenger_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.passenger_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.passenger_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}