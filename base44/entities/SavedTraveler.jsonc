{
  "name": "SavedTraveler",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email who saved this traveler"
    },
    "label": {
      "type": "string",
      "description": "Label for quick identification (e.g., 'Myself', 'Wife', 'Son')"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "gender": {
      "type": "string",
      "enum": [
        "MALE",
        "FEMALE"
      ],
      "description": "Gender"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "passport_number": {
      "type": "string",
      "description": "Passport number"
    },
    "passport_country": {
      "type": "string",
      "description": "Passport issuing country"
    },
    "passport_expiry": {
      "type": "string",
      "format": "date",
      "description": "Passport expiry date"
    },
    "nationality": {
      "type": "string",
      "description": "Nationality"
    }
  },
  "required": [
    "user_email",
    "first_name",
    "last_name"
  ]
}