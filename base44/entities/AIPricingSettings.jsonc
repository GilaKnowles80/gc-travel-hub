{
  "name": "AIPricingSettings",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "Reference to supplier"
    },
    "ai_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable AI pricing"
    },
    "auto_apply": {
      "type": "boolean",
      "default": false,
      "description": "Automatically apply suggestions"
    },
    "max_increase_percentage": {
      "type": "number",
      "default": 20,
      "description": "Max price increase %"
    },
    "max_decrease_percentage": {
      "type": "number",
      "default": 30,
      "description": "Max price decrease %"
    },
    "min_confidence_score": {
      "type": "number",
      "default": 70,
      "description": "Minimum AI confidence to suggest"
    },
    "update_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "biweekly"
      ],
      "default": "weekly",
      "description": "How often to analyze"
    },
    "priority_metric": {
      "type": "string",
      "enum": [
        "revenue",
        "bookings",
        "balanced"
      ],
      "default": "balanced",
      "description": "What to optimize for"
    }
  },
  "required": [
    "supplier_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}