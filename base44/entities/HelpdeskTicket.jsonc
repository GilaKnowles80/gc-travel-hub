{
  "name": "HelpdeskTicket",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "general",
        "tour",
        "flights",
        "visa",
        "bus",
        "car_rental",
        "ferry",
        "hotel",
        "travel_insurance",
        "refund",
        "dispute",
        "complaint"
      ],
      "description": "Inquiry category"
    },
    "email": {
      "type": "string",
      "description": "Customer email"
    },
    "name": {
      "type": "string",
      "description": "Customer name"
    },
    "subject": {
      "type": "string",
      "description": "Ticket subject"
    },
    "message": {
      "type": "string",
      "description": "Detailed message"
    },
    "phone": {
      "type": "string",
      "description": "Customer phone"
    },
    "booking_reference": {
      "type": "string",
      "description": "Related booking ID if applicable"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Ticket status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priority level"
    },
    "assigned_to": {
      "type": "string",
      "description": "Admin email assigned to this ticket"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal notes for staff"
    },
    "response_email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether response email was sent to customer"
    },
    "resolved_date": {
      "type": "string",
      "format": "date",
      "description": "Date ticket was resolved"
    }
  },
  "required": [
    "category",
    "email",
    "name",
    "subject",
    "message"
  ]
}