{
  "name": "Car",
  "type": "object",
  "properties": {
    "rental_company": {
      "type": "string",
      "enum": [
        "Hertz",
        "Avis",
        "Budget",
        "Enterprise",
        "Sixt",
        "National",
        "Alamo",
        "Thrifty",
        "Dollar",
        "Europcar",
        "Other"
      ],
      "description": "Car rental company"
    },
    "car_model": {
      "type": "string",
      "description": "Car model name"
    },
    "car_type": {
      "type": "string",
      "enum": [
        "economy",
        "compact",
        "midsize",
        "fullsize",
        "suv",
        "luxury",
        "van",
        "pickup"
      ],
      "description": "Type of vehicle"
    },
    "location": {
      "type": "string",
      "description": "Rental location city/country"
    },
    "pickup_location": {
      "type": "string",
      "description": "Pickup address"
    },
    "seats": {
      "type": "number",
      "description": "Number of seats"
    },
    "transmission": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "description": "Transmission type"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "gasoline",
        "diesel",
        "electric",
        "hybrid"
      ],
      "description": "Fuel type"
    },
    "price_per_day": {
      "type": "number",
      "description": "Daily rental rate"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Car features (GPS, AC, etc.)"
    },
    "insurance_included": {
      "type": "boolean",
      "default": false,
      "description": "Basic insurance included"
    },
    "image_url": {
      "type": "string",
      "description": "Car image"
    },
    "availability": {
      "type": "boolean",
      "default": true,
      "description": "Currently available"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "rental_company",
    "car_model",
    "car_type",
    "location",
    "price_per_day"
  ]
}