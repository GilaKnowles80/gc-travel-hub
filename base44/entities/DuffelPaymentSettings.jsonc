{
  "name": "DuffelPaymentSettings",
  "type": "object",
  "properties": {
    "duffel_account_id": {
      "type": "string",
      "description": "Duffel account ID"
    },
    "duffel_balance_usd": {
      "type": "number",
      "default": 0,
      "description": "Current Duffel account balance in USD"
    },
    "minimum_balance_threshold": {
      "type": "number",
      "default": 500,
      "description": "Minimum balance to maintain before alerting"
    },
    "auto_topup_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable automatic top-ups when balance falls below threshold"
    },
    "auto_topup_amount": {
      "type": "number",
      "description": "Amount to top-up when threshold reached (in USD)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "duffel_beneficiary": {
      "type": "string",
      "description": "Beneficiary name for bank transfer"
    },
    "duffel_account_number": {
      "type": "string",
      "description": "Duffel bank account number"
    },
    "duffel_aba_routing": {
      "type": "string",
      "description": "ABA routing number"
    },
    "duffel_bank_address": {
      "type": "string",
      "description": "Bank address for wire transfer"
    },
    "duffel_swift": {
      "type": "string",
      "description": "SWIFT/BIC code"
    },
    "duffel_payment_reference": {
      "type": "string",
      "description": "Unique payment reference (must match exactly)"
    }
  },
  "required": [
    "duffel_account_id"
  ]
}