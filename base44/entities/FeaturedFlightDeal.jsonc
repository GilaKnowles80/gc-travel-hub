{
  "name": "FeaturedFlightDeal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Deal title e.g. Manila to Tokyo"
    },
    "origin_code": {
      "type": "string",
      "description": "IATA origin code e.g. MNL"
    },
    "origin_city": {
      "type": "string",
      "description": "Origin city name"
    },
    "destination_code": {
      "type": "string",
      "description": "IATA destination code e.g. NRT"
    },
    "destination_city": {
      "type": "string",
      "description": "Destination city name"
    },
    "airline": {
      "type": "string",
      "description": "Airline name"
    },
    "flight_number": {
      "type": "string",
      "description": "Flight number(s)"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "trip_type": {
      "type": "string",
      "enum": [
        "one_way",
        "roundtrip"
      ],
      "default": "roundtrip"
    },
    "price_php": {
      "type": "number",
      "description": "Price in PHP"
    },
    "price_usd": {
      "type": "number",
      "description": "Price in USD"
    },
    "original_price_php": {
      "type": "number",
      "description": "Original price before discount"
    },
    "cabin_class": {
      "type": "string",
      "enum": [
        "economy",
        "premium_economy",
        "business",
        "first_class"
      ],
      "default": "economy"
    },
    "seats_available": {
      "type": "number",
      "description": "Number of seats available"
    },
    "baggage_allowance": {
      "type": "string",
      "description": "e.g. 1 PC 20kg"
    },
    "image_url": {
      "type": "string",
      "description": "Destination image URL"
    },
    "supplier": {
      "type": "string",
      "enum": [
        "biyaheko",
        "wanderlinx",
        "tripzynx",
        "direct"
      ],
      "default": "biyaheko"
    },
    "supplier_reference": {
      "type": "string",
      "description": "PNR or reference from supplier"
    },
    "inclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold_out",
        "expired"
      ],
      "default": "active"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Deal expiry date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "origin_code",
    "destination_code",
    "price_php",
    "airline"
  ]
}