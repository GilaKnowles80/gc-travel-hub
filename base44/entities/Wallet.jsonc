{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email address"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Available (withdrawable) wallet balance"
    },
    "held_balance": {
      "type": "number",
      "default": 0,
      "description": "Funds held in escrow pending booking confirmation (released to balance on failure, split to merchants/admin on success)"
    },
    "total_earned": {
      "type": "number",
      "default": 0,
      "description": "Total amount earned/credited"
    },
    "total_withdrawn": {
      "type": "number",
      "default": 0,
      "description": "Total amount withdrawn"
    },
    "total_used": {
      "type": "number",
      "default": 0,
      "description": "Total amount used for bookings"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "closed"
      ],
      "default": "active",
      "description": "Wallet status"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}