{
  "name": "FlightBooking",
  "type": "object",
  "properties": {
    "booking_ref": {
      "type": "string",
      "description": "Human-readable sequential booking reference (e.g. FB-0001)"
    },
    "flight_id": {
      "type": "string",
      "description": "Reference to the flight"
    },
    "offer_id": {
      "type": "string",
      "description": "Duffel offer ID used to create the airline order"
    },
    "supplier_fare": {
      "type": "number",
      "description": "Airline base fare (Duffel order total, ~75% of customer total)"
    },
    "supplier_currency": {
      "type": "string",
      "description": "Currency of the Duffel offer (e.g. USD)"
    },
    "flight_number": {
      "type": "string",
      "description": "Flight number for quick reference"
    },
    "route": {
      "type": "string",
      "description": "Origin - Destination route"
    },
    "trip_type": {
      "type": "string",
      "enum": [
        "one_way",
        "roundtrip"
      ],
      "default": "roundtrip",
      "description": "Trip type"
    },
    "passenger_name": {
      "type": "string",
      "description": "Full name of passenger"
    },
    "passenger_email": {
      "type": "string",
      "description": "Passenger email"
    },
    "passenger_phone": {
      "type": "string",
      "description": "Passenger phone number"
    },
    "passport_number": {
      "type": "string",
      "description": "Passport number"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Passenger date of birth"
    },
    "cabin_class": {
      "type": "string",
      "enum": [
        "economy",
        "premium_economy",
        "business",
        "first_class"
      ],
      "description": "Selected cabin class"
    },
    "number_of_passengers": {
      "type": "number",
      "default": 1,
      "description": "Number of passengers"
    },
    "total_price": {
      "type": "number",
      "description": "Total booking price (customer-paid, incl. markup)"
    },
    "special_requests": {
      "type": "string",
      "description": "Meal preferences, seat requests, etc."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid",
        "refunded"
      ],
      "default": "unpaid",
      "description": "Payment status"
    },
    "supplier": {
      "type": "string",
      "enum": [
        "biyaheko",
        "wanderlinx",
        "tripzynx",
        "duffel",
        "direct"
      ],
      "description": "Supplier used for booking"
    },
    "supplier_reference": {
      "type": "string",
      "description": "Reference number from supplier (Duffel order ID / airline booking reference)"
    },
    "price_comparison_notes": {
      "type": "string",
      "description": "Notes on price comparison across suppliers"
    }
  },
  "required": [
    "flight_id",
    "passenger_name",
    "passenger_email",
    "cabin_class",
    "trip_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.passenger_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.passenger_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.passenger_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}