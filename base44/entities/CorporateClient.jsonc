{
  "name": "CorporateClient",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Company name"
    },
    "contact_person": {
      "type": "string",
      "description": "Primary contact person"
    },
    "email": {
      "type": "string",
      "description": "Corporate email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "discount_percentage": {
      "type": "number",
      "default": 5,
      "description": "Default discount percentage for this client"
    },
    "credit_limit": {
      "type": "number",
      "default": 0,
      "description": "Credit limit for invoicing"
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "immediate",
        "net_7",
        "net_15",
        "net_30"
      ],
      "default": "immediate",
      "description": "Payment terms"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "tax_id": {
      "type": "string",
      "description": "Business tax ID"
    },
    "billing_address": {
      "type": "string",
      "description": "Billing address"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "company_name",
    "contact_person",
    "email"
  ]
}